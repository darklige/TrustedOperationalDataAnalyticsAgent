OPENAI_API_KEY=
# Use responses (default) or chat_completions for an OpenAI-compatible gateway.
TRUST_AGENT_PROVIDER=responses
# For chat_completions, set this to the gateway's /v1 base URL (not /chat/completions).
# OPENAI_BASE_URL=https://example.com/v1
TRUST_AGENT_MODEL=
# Per Chat Completions request; raise only after checking truncation and token budget.
TRUST_AGENT_MAX_OUTPUT_TOKENS=1024
# Optional provider-specific JSON body, for example {"enable_thinking":false}.
# TRUST_AGENT_CHAT_EXTRA_BODY={"enable_thinking":false}
TRUST_AGENT_DB=data/nyc_taxi.duckdb
TRUST_AGENT_STATE_DB=runtime/agent.sqlite3
TRUST_AGENT_MAX_TURNS=8
TRUST_AGENT_CONTEXT_CHAR_BUDGET=45000
TRUST_AGENT_MAX_TOTAL_TOKENS=100000
TRUST_AGENT_MAX_WALL_SECONDS=300
